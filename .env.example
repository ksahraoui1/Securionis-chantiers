# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend (email)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=rapports@chantiers.votre-domaine.com

# Anthropic (assistant IA)
ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe (paiement)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# App
NEXT_PUBLIC_APP_URL=https://chantiers.votre-domaine.com
NEXT_PUBLIC_APP_ENV=production

# Web Push (notifications PWA) — optionnel
# Générer les clés : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY est exposée côté client (normal, c'est sa fonction)
# VAPID_PRIVATE_KEY doit rester secrète
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rapports@securionis.com

# Sentry (monitoring d'erreurs) — optionnel, le code est no-op si DSN absent
# Créer un projet sur https://sentry.io → Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN doit être identique côté client et server
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Pour upload des source maps (optionnel, améliore les stack traces) :
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
